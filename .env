# 1. PUERTO DEL SERVIDOR
# Define el puerto lógico en el que Express escuchará las peticiones entrantes.
# Se usa 3000 por convención para entornos de desarrollo local.
PORT=3000

# 2. CADENA DE CONEXIÓN (CONNECTION STRING)
# Contiene las credenciales necesarias para autenticarse con el clúster de MongoDB Atlas.
# Incluye el protocolo (mongodb+srv), el usuario (21680156), la contraseña y el host.
# IMPORTANTE: Mantener esto en un .env evita que las claves se suban a repositorios públicos.
MONGO_URI=mongodb+srv://21680156:loco25gt@cluster0.iy2zb06.mongodb.net/?appName=SeguridadWeb


JWT_SECRET=seguridadwebsecretkey